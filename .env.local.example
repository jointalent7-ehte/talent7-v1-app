NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: required for admin completion of verified account-deletion requests.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://www.jointalent7.com
# Add the Play Console App signing SHA-256 fingerprint here. Separate multiple fingerprints with commas.
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
# Public Cloudflare Turnstile site key. The matching secret belongs only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn
# Optional: enables the protected /api/sentry-test verification endpoint.
SENTRY_TEST_TOKEN=use_a_long_random_value
# Optional: enables source-map uploads during production builds.
SENTRY_AUTH_TOKEN=your_sentry_build_token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=talent7-media
R2_PUBLIC_BASE_URL=https://your-public-r2-domain.example.com
# Server-only Razorpay credentials and webhook signing secret.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Server-only Google Play Developer API service account JSON (raw JSON or base64-encoded JSON).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Long random token appended to the Google Play RTDN push endpoint.
GOOGLE_PLAY_RTDN_TOKEN=
